// Zenoh session config for nodes without a pinned camera flow. Derived from
// /opt/ros/jazzy/share/rmw_zenoh_cpp/config/DEFAULT_RMW_ZENOH_SESSION_CONFIG.json5
// with the router endpoint pointed at the wired IVN instead of localhost.
{
  mode: "peer",
  connect: {
    endpoints: ["tcp/10.0.0.10:7448"],
  },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: true },
  },
}
