// HPC-side zenoh-bridge-ros2dds for the control flow (AUTOSDV_RMW=zenoh_bridge).
//
// The second half of environment 3; see zenoh_bridge_camera_ivn.json5 for the
// topology and the per-camera ports on the other bridge.
// This one carries the control flow only:
//   /topic_control_signal   HPC -> ZCU   motion command
//
// Health has its own bridge on 7449 (zenoh_bridge_health_ivn.json5), so the
// CS6 rule network_qos/autosdv_dscp_qos.py installs for egress from 7448 is
// control traffic alone, and a closed Q6 gate no longer takes health with it.
{
  plugins: {
    ros2dds: {
      nodename: "zenoh_bridge_control",

      // See zenoh_bridge_camera_ivn.json5 on why the DDS domain is not pinned.

      // Local DDS publisher: command out.
      allow: {
        publishers: ["/topic_control_signal"],
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: [],
      },

      // Applies only to RELIABLE DDS routes. MotionCommand currently uses
      // BEST_EFFORT; this setting does not change its QoS or guarantee delivery.
      reliable_routes_blocking: true,
    },
  },

  mode: "router",

  listen: {
    endpoints: [
      "tcp/0.0.0.0:7448",
      "udp/0.0.0.0:7448",
    ],
  },

  connect: {
    endpoints: [],
  },

  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },

  transport: {
    link: {
      tx: {
        batch_size: 1400,
      },
    },
  },
}
