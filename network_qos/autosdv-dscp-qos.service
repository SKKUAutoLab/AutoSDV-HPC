[Unit]
Description=AutoSDV wired-IVN DSCP classifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/autosdv-dscp-qos watch --cleanup-on-exit
Restart=on-failure
RestartSec=1

# Run as the GUI/ROS user so Linux ptrace access checks allow the daemon to
# follow that user's /proc/<pid>/fd socket links.  systemd grants only the
# network-administration capability needed by nftables.
User=@AUTOSDV_USER@
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
