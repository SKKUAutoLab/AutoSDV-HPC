<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_cloud_pkg</name>
  <version>0.1.0</version>
  <description>AutoSDV MQTT diagnostics gateway and WHIP camera streamer.</description>
  <maintainer email="autolab@example.com">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
