<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autosdv_gui_pkg</name>
  <version>0.1.0</version>
  <description>Integrated HPC control GUI and safety supervisor for AutoSDV.</description>
  <maintainer email="autolab@example.com">AutoSDV Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>interfaces_pkg</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>autosdv_gui_preview_bridge_pkg</depend>
  <exec_depend>debug_pkg</exec_depend>
  <exec_depend>ivn_diagnostics_pkg</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- launch_pkg.rmw_profile selects the DDS middleware and its profile. -->
  <depend>launch_pkg</depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>data_collection_pkg</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
