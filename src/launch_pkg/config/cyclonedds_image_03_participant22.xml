<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cyclone DDS counterpart of fastdds_image_03_participant22.xml.
  participantID 22 -> Discovery/ParticipantIndex 22
  (unicast meta port 7454, user data 7455).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- IVN discovery and payload delivery must not depend on multicast. -->
      <AllowMulticast>false</AllowMulticast>
      <Interfaces>
        <NetworkInterface address="10.0.0.10" priority="default" multicast="default"/>
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>22</ParticipantIndex>
      <MaxAutoParticipantIndex>19</MaxAutoParticipantIndex>
      <Peers>
        <!-- Discover HPC processes explicitly when multicast is disabled. -->
        <Peer address="10.0.0.10"/>
        <Peer address="10.0.0.3"/>
      </Peers>
    </Discovery>
    <Internal>
      <!-- Request 8 MiB: the ~900 KB images republished on the HPC overflow the
           default buffer. Needs net.core.rmem_max >= 8 MiB
           (config/sysctl/90-autosdv-udp-buffers.conf); no hard minimum, so a
           host without it degrades instead of failing to start. -->
      <SocketReceiveBufferSize max="8MiB"/>
    </Internal>
  </Domain>
</CycloneDDS>
